# Redis Cloud database access. Use the Terraform redis_url and redis_tls outputs.
REDIS_URL=redis://default:REPLACE_ME@your-redis-cloud-host:port
REDIS_TLS=false

# Optional when REDIS_URL does not include credentials.
REDIS_USERNAME=default
REDIS_PASSWORD=REPLACE_ME

# Seed sizing. Keep small for local smoke tests, raise for demos/benchmarks.
SEED_ACCOUNTS=100
SEED_SECURITIES=500
SEED_POSITIONS_PER_ACCOUNT=8
SEED_TRANSACTIONS=6000
SEED_ACCOUNT_BYTES=102400
SEED_SECURITY_BYTES=8192
SEED_POSITION_BYTES=8192
SEED_TRANSACTION_BYTES=8192
SEED_RANDOM=20260518

# memtier_benchmark transaction-data target:
# threads * clients * transaction_rate_per_connection = target transaction records/sec
# 4 * 50 * 300 = 60,000 transaction-data ops/sec
MEMTIER_THREADS=4
MEMTIER_CLIENTS=50
MEMTIER_PIPELINE=16
MEMTIER_TRANSACTION_RATE_PER_CONNECTION=300
MEMTIER_RATE_PER_CONNECTION=75
MEMTIER_TEST_TIME=60

# Trade-write monitor generation. Keep command count modest unless the runner
# has enough disk/network capacity; memtier will replay the file at target rate.
MEMTIER_TRADE_COMMANDS=10000
MEMTIER_TRADE_PAYLOAD_BYTES=1024
