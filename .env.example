# Redis Cloud database access. Use the Terraform redis_url and redis_tls outputs.
REDIS_URL=redis://default:REPLACE_ME@your-redis-cloud-host:port
REDIS_TLS=false

# Optional when REDIS_URL does not include credentials.
REDIS_USERNAME=default
REDIS_PASSWORD=REPLACE_ME
# Multiplex requests across a small pool so large hydrations do not block point reads.
REDIS_POOL_SIZE=32
# Local development serves every pool. AWS workers use one of the six pool names.
API_WORKLOAD_CLASS=mixed
# Reject excess work before it waits for a Redis connection.
API_MAX_CONCURRENT_LIGHT=128
API_MAX_CONCURRENT_POSITIONS=32
API_MAX_CONCURRENT_TRANSACTIONS=32
API_MAX_CONCURRENT_PORTFOLIO=16
API_MAX_CONCURRENT_ACTIVITY=16
API_MAX_CONCURRENT_SNAPSHOT=32
# Optional per-pattern soft reservations expose fair-share usage. A pattern may
# borrow above its reservation while the pool still has free capacity.
# API_MAX_CONCURRENT_PATTERN_ACCOUNT_BY_ID=18
# API_MAX_CONCURRENT_PATTERN_TRANSACTIONS_BY_ACCOUNT=16

# Seed sizing. Keep small for local smoke tests, raise for demos/benchmarks.
SEED_ACCOUNTS=100
SEED_SECURITIES=500
SEED_POSITIONS_PER_ACCOUNT=60
SEED_TRANSACTIONS=30000
SEED_SECURITY_BYTES=8192
SEED_POSITION_BYTES=8192
SEED_TRANSACTION_BYTES=8192
SEED_RANDOM=20260518

# Query-pattern load tests call the same /api/query route as the web UI.
QUERY_BASE_URL=http://127.0.0.1:3000
QUERY_DEFAULT_TARGET_RPS=9000
QUERY_JOIN_TARGET_RPS=45000
QUERY_TEST_TIME=60
QUERY_MAX_IN_FLIGHT=10000
# The wall-clock timeout includes time waiting for an HTTP socket.
QUERY_REQUEST_TIMEOUT_MS=30000
QUERY_SOCKET_TIMEOUT_MS=30000
QUERY_DRAIN_TIMEOUT_MS=30000
# Set to gzip only when compressed responses match production client behavior.
# QUERY_ACCEPT_ENCODING=gzip
QUERY_STAIRCASE_PATTERN=accountById
# Use 1 for a direct API target or the active target count for an ALB pool.
QUERY_STAIRCASE_TARGET_COUNT=1
QUERY_STAIRCASE_RATES=1000,2000,4000,8000
QUERY_STAIRCASE_P95_SLO_MS=250
QUERY_STAIRCASE_MAX_ERROR_RATE=0.001
QUERY_STAIRCASE_MIN_ACHIEVEMENT_RATIO=0.98
QUERY_STAIRCASE_HEADROOM_FACTOR=1.3

# Atomic trade-write load through FCALL apply_transaction.
MEMTIER_TRADE_TARGET_RPS=30000
MEMTIER_TRADE_THREADS=4
MEMTIER_TRADE_CLIENTS=50
MEMTIER_TRADE_PIPELINE=64
MEMTIER_TEST_TIME=60
# macOS memtier may not use the system Keychain CA store. Set a CA bundle
# with MEMTIER_TLS_CACERT to verify certificates instead of skipping.
MEMTIER_TLS_SKIP_VERIFY=true
# MEMTIER_TLS_CACERT=/path/to/ca-bundle.pem

# Trade-write documents are created under unique run-specific transaction keys.
MEMTIER_TRADE_PAYLOAD_BYTES=1024
TRADE_MAX_IN_FLIGHT=10000
TRADE_SAMPLE_POOL_SIZE=1000
TRADE_ACCOUNT_DISCOVERY_POOL_SIZE=5000
# Distributed AWS concurrent runs reserve this many generator hosts for writes.
TRADE_GENERATOR_COUNT=2
