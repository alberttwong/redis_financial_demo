# Initial load profile for the SQL-batched demo.
# Source this after .env.local when intentionally loading a database sized for it.

SEED_ACCOUNTS=6600
SEED_SECURITIES=3960
SEED_POSITIONS_PER_ACCOUNT=500
SEED_TRANSACTIONS=240900000
SEED_SECURITY_BYTES=8192
SEED_POSITION_BYTES=8192
SEED_TRANSACTION_BYTES=8192
SEED_RANDOM=20260518
SEED_AS_OF_DATE=2026-07-22

# Load tuning.
SEED_BATCH_SIZE=2000
SEED_WRITE_CONCURRENCY=8
SEED_SNAPSHOT_CONCURRENCY=25
SEED_INDEX_TIMEOUT_MS=21600000
SEED_RESUME=true
SEED_RESET_CHECKPOINTS=false
SEED_DROP_INDEXES_BEFORE_LOAD=true
SEED_SKIP_SNAPSHOTS=false

# Safety guard used by scripts/seed-initial-load.sh.
CONFIRM_INITIAL_LOAD=6600
